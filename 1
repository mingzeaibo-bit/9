            _Vs, _bs, _sh, _Nd, _Td = crosswear_contract.dual_fit_full(m["V"], m["BI"], m["BW"], list(bnames), XW, shapes_o,
                                                                       m["N"], m["TAN"])
            mp_disp = mesh_object(f"{CFG['display_name']}_{info['item']}_XW", _Vs, _Nd, _Td, None,
