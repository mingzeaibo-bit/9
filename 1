                            {0: sz["UV0"], 1: sz["UV1"], 2: sz["UV2"]}, [sz["SUB0"], sz["SUB1"]], sz["BI"], sz["BW"], sshapes, bind=sbind)
    suit_tex = {"_MainTex": tex_if(f"{CFG['display_name']}_Body_MainTex"), "_BumpMap": tex_if(f"{CFG['display_name']}_Body_BumpMap"),
