# Authored for her mouth: jaw drops for open vowels, lip press for bilabials, pout for rounded vowels, tongue for TH.
def vis(name, **vals):
    vs = []
    for k, v in vals.items():
        x, y, z = (v if isinstance(v, tuple) else (v, 0.0, 0.0))
        vs.append({"name": k, "value": float(x if x else (y if y else z)), "values": v3((x, y, z))})
    return {"name": name, "variables": vs}
