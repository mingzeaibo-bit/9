                                np.stack([np.linalg.inv(W_rest[b]) for b in bn]))
        tp = f"{CFG['display_name']}_{name}"
        if kind == "pubes":                                      # alpha-tested decal (INTEGRATION §3)
            mt = material(tp, "Unified", {k: v for k, v in (("_MainTex", tex_if(tp + "_MainTex")), ("_BumpMap", tex_if(tp + "_BumpMap")),
