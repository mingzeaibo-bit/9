def _tiny_transparency(name):
    """cfg tiny_transparency_opaque (absent = old behaviour): a <prefix>_TransparencyMap of <= 8 px per side is the texture
    baker's 'constant map as 4x4' shortcut (own_textures TFA_CONST_4X4 / TFA_CAPS TransparencyMap=4). It is only right for a
    constant 255 map; a 4x4 box reduction of a COVERAGE mask (shared set Shion_BodyDefaultShared: alpha 0.3 inside the islands
    only) gives alpha 0.4-0.66 at every texel -> Unified dithers the whole item (screen-door stipple, 2026-10-25 tester S2: shoes,
    jacket, horns, teeth, straps). Shipped opaque materials bind NO _TransparencyMap (tifa Boots: None), so skip it."""
    if not CFG.get("tiny_transparency_opaque") or not name.endswith("_TransparencyMap"):
        return False
    try:
        m_ = json.load(open(tex_file(name, ".json")))
    except Exception:
        return False
    return max(int(m_.get("width", 0)), int(m_.get("height", 0))) <= 8


def tex_if(name):
    if name in TEXCACHE:
        return TEXCACHE[name]
    if _tiny_transparency(name) and os.path.isfile(tex_file(name, ".json")):
        REPORT.setdefault("tiny_transparency_skipped", []).append(name)
        TEXCACHE[name] = None
        return None
    TEXCACHE[name] = texture(name) if os.path.isfile(tex_file(name, ".json")) else None
    return TEXCACHE[name]


def mat_for(obj_tag, kind, mat_name, tex_tag=None):
    _keys = ("MainTex", "BumpMap", "SmoothnessMap", "EmissionMap", "TransparencyMap")
    if CFG.get("textures_bound_only") and CFG.get("cloth_shader", "Unified") != "StandardAdvanced":
        # REVIEW D2: Unified binds no _EmissionMap; it only stands in for a missing _MainTex (cloth_material), so it is
        # loaded (= written into the bundle) only then. m20: ~460 MB of emission maps nobody referenced.
        tx = {k: tex_if(f"{tex_tag or obj_tag}_{k}") for k in _keys if k != "EmissionMap"}
        tx["EmissionMap"] = None if tx.get("MainTex") else tex_if(f"{tex_tag or obj_tag}_EmissionMap")
    else:
        tx = {k: tex_if(f"{tex_tag or obj_tag}_{k}") for k in _keys}
    _tag = f"{obj_tag} {mat_name}"
    if kind == "eyeshadow":
        # texture baker section 9b (values = official akali `Eyeshadow`): StandardAdvanced pass 0 multiply overlay, needs the embedded shader (cfg embed_shaders)
        _t = tex_if(mat_name + "_MainTex")
        return material(mat_name, "StandardAdvanced", {"_MainTex": _t} if _t else {},
                        {"_Mode": 2.0, "_SrcBlend": 5.0, "_DstBlend": 10.0, "_ZWrite": 0.0, "_Metallic": 1.0, "_Glossiness": 0.0,
                         "_Cull": 0.0, "_Cutoff": 0.5, "_Specular": 0.05, "_IsWet": 1.0},
                        {"_Color": (1.0, 1.0, 1.0, 1.0), "_EmissionColor": (0.0, 0.0, 0.0, 1.0)},
                        keywords=("_ALPHABLEND_ON",), queue=3000, tags=[("RenderType", "Transparent")])
    # REVIEW D18 / pitfall V13: fabrics (bikini, shorts), nails and lace were lit with the SKIN (SSS 2) or HAIR (SSS 5)
    # profile because "unified"/"cutout" start from skin_f. Only real skin-like overlays keep it (cfg "skin_like_tags").
    _skin_like = any(k in _tag for k in CFG.get("skin_like_tags", ["Decal"]))
    _lash_brow = any(k in _tag for k in ("Eyelash", "Eyebrow", "Lashes", "Brows"))
    if kind == "cutout" and _lash_brow and not _skin_like and CFG.get("lashes_brows_standard_advanced"):
        # zero-loss plan D5-A2 (cfg lashes_brows_standard_advanced = {"queue": 3000, "color": [1, 1, 1, 1]}): eyelashes + eyebrows like EVERY shipped character (akali / queen / asuna / irelia: StandardAdvanced Fade,
        # runtime dump of Eyelashes: _Mode 2, _SrcBlend 5, _DstBlend 10, _ZWrite 0, _Metallic 1, _Glossiness 0, _Cull 0, _Cutoff 0.5, _Specular 0.05, _IsWet 1, queue 3000/3001, keywords _ALPHABLEND_ON + _ISWET_ON, _MainTex only):
        # Game.PreUpdatePhysics registers a capture tuple only for shader `Unified` (SEGI draws it 6x per tuple), so two tuples less. Needs embed_shaders StandardAdvanced; look A/B in the lab first.
        _ls = CFG["lashes_brows_standard_advanced"]
        _t = tx.get("MainTex")
        return material(mat_name, "StandardAdvanced", {"_MainTex": _t} if _t else {},
                        {"_Mode": 2.0, "_SrcBlend": 5.0, "_DstBlend": 10.0, "_ZWrite": 0.0, "_Metallic": 1.0, "_Glossiness": 0.0, "_Cull": 0.0, "_Cutoff": 0.5, "_Specular": 0.05, "_IsWet": 1.0,
                         "_IsColored": 0.0, "_Albedo_Contrast": 1.0, "_Normals_Scale": 1.0, "_SubsurfaceID": 0.0},
                        {"_Color": tuple(_ls.get("color", (1.0, 1.0, 1.0, 1.0))), "_EmissionColor": (0.0, 0.0, 0.0, 1.0)},
                        keywords=("_ALPHABLEND_ON", "_ISWET_ON"), queue=int(_ls.get("queue", 3000)), tags=[("RenderType", "Transparent")])
    if kind == "unified" and not _skin_like:
        return cloth_material(mat_name, tx)
    if kind == "cutout" and not (_skin_like or _lash_brow):
        return cloth_material(mat_name, tx)                    # lace etc.: cloth + alpha clip from _TransparencyMap
    if kind in ("unified", "eye", "hair", "tongue", "cutout", "teeth"):
        tex = {f"_{k}": v for k, v in tx.items() if v and k not in ("EmissionMap",)}
        f = dict(skin_f, _IsColored=1.0)
        kw = ["_ISWET_ON", "_ISCOLORED_ON", "_HIDEVERTEXALPHA_ON"]
        # reference runtime values per material class (shipped M_*_Eyes/Hair/Mouth/Head): subsurface profiles, cutouts
        if kind == "eye":
            f.update({"_SubsurfaceID": 4.0, "_Cutoff": 0.5, "_Albedo_Contrast": 1.2}); kw = ["_HIDEVERTEXALPHA_ON"]
            if CFG.get("material_lint_fixes"):
                kw = ["_ISWET_ON", "_HIDEVERTEXALPHA_ON"]
            if MATPROF == "unified_v1":
                f["_SubsurfaceID"] = 0.0                       # 130/134 shipped eyes; profile 4 blurs the iris
        elif kind in ("tongue", "teeth"):
            f.update({"_SubsurfaceID": 3.0, "_Cutoff": 0.5}); kw = ["_ISWET_ON", "_HIDEVERTEXALPHA_ON"]
        elif kind == "hair":
            f.update({"_IS_HAIR_SPECULAR": 1.0, "_SubsurfaceID": 5.0, "_Specular": 0.3, "_Cutoff": 0.27})   # 0.3: hard hair plates (live check m7_spec)
            if MATPROF == "unified_v1":
                f.update({"_IS_HAIR_SPECULAR": 0.0, "_Specular": 0.05})   # 238/238 shipped hair (references/27)
            kw = ["_ISWET_ON", "_HIDEVERTEXALPHA_ON"] + (["_ALPHATEST_ON"] if "_TransparencyMap" in tex else [])
        elif kind == "cutout":                                 # lashes / brows: Unified alpha clip (hair profile)
            f.update({"_Cutoff": 0.5, "_Cull": 0.0}); kw = ["_ALPHATEST_ON", "_HIDEVERTEXALPHA_ON"]
            if CFG.get("material_lint_fixes"):
                kw = ["_ALPHATEST_ON", "_ISWET_ON", "_HIDEVERTEXALPHA_ON"]
                if _skin_like:
                    f["_SmoothnessBoost"] = -0.3                   # decal smoothness map reads 0.87 (mirror) in the lint
            if not _skin_like:                                 # skin decals keep the skin SSS profile (printed on skin)
                f["_SubsurfaceID"] = 5.0
        return material(mat_name, "Unified", tex, f, {"_Color": (1, 1, 1, 1)}, keywords=kw)
    if CFG.get("cloth_shader", "Unified") == "StandardAdvanced":
        # emissive overlay (game's StandardAdvanced: opaque, emission, no transparency). In-game (build 6, 2026-10-15) every
        # StandardAdvanced material of ours rendered flat white whatever was set, so this is kept only as an opt-in.
        tex = {"_MainTex": tx["MainTex"]} if tx["MainTex"] else {}
        if tx["BumpMap"]:
            tex["_BumpMap"] = tx["BumpMap"]
        if tx["EmissionMap"]:
            tex["_EmissionMap"] = tx["EmissionMap"]
        f = {"_Glossiness": 0.8, "_Metallic": 0.0, "_BumpScale": 1.0, "_Cull": 2.0}
        kw = (["_NORMALMAP"] if tx["BumpMap"] else []) + (["_EMISSION"] if tx["EmissionMap"] else [])
        return material(mat_name, "StandardAdvanced", tex, f, {"_Color": (1, 1, 1, 1), "_EmissionColor": (1, 1, 1, 1)}, keywords=kw)
    if kind == "robot" and MATPROF == "unified_v1" and tex_if(f"{tex_tag or obj_tag}_SpecGlossMap"):
        # principled_to_unified maps (the developer's rule): MainTex = Base Color, _SpecGlossMap.r = metalness, smoothness =
        # 1 - roughness, _Specular 1 = "as authored" -> grey satin metal (sweep R1/R4) instead of black vinyl
        # shader recipes r3 (sweep v2 on m21a): +0.15 smoothness boost on the converted robot plates = most depth (cfg)
        return cloth_material(mat_name, tx, spec_gloss=tex_if(f"{tex_tag or obj_tag}_SpecGlossMap"), specular=float(CFG.get("robot_specgloss_specular", 1.0)),     # cfg: < 1 keeps part of the albedo (garment-fit lab A/B, m21f2)
                              smoothness_boost=0.0 if obj_tag in CFG.get("robot_specgloss_boost_exclude", [])
                              else float(CFG.get("robot_specgloss_smoothness_boost", 0.0)))   # e.g. the weapon on the
                              # body-default shared set (map ~0.9): +0.15 would exceed 1 (lint 1.06)
    if kind == "robot":
        # her robotic limbs/neck/chest plates (source material Shion_Cloth_Default: metallic 1, clear coat): glossier,
        # brighter specular than fabric (user: "robotic parts should be robotic material"); tune live with `mat`
        return cloth_material(mat_name, tx, specular=float(CFG.get("robot_specular", 0.6)),
                              smoothness_boost=float(CFG.get("robot_smoothness_boost", 0.15)))
    return cloth_material(mat_name, tx)


def cloth_material(mat_name, tx, spec_gloss=None, specular=None, smoothness_boost=None, cutoff=None):
    if specular is None:                                       # fabric default: 0.2 (live sweep m7) / 0 with material_profile
        specular = 0.0 if MATPROF == "unified_v1" else 0.2
    if smoothness_boost is None:                               # jacket -0.25 with material_profile (sweep J2)
        smoothness_boost = -0.25 if MATPROF == "unified_v1" and "_Outfit_" in mat_name else 0.0
    # specular 0.2 / boost 0: live sweep on build 7 (proof/ingame_serve/m7_spec) — the shipped 1.0 relies on their dark
    # _SpecGlossMap; without one our garments turned into chrome at 1.0 / 0.5, 0.2 matches the model's semi-gloss cloth
    """Clothing / accessory material the way the shipped characters dress (runtime dump of M_TifaR_ClothesA: Unified,
    _Specular 1, _SmoothnessBoost 0.1, _SmoothnessContrast 1, _Cull 0, _Color 1,1,1,1, _IsColored 0, _IsWet 1,
    _SubsurfaceID 0, _Cutoff 0.5, keywords _ISWET_ON (+ _ALPHATEST_ON with a transparency map)). Unified has no emission
    slot: an emissive piece uses its emission bake as albedo when the colour bake is missing (LED strips stay bright)."""
    main = tx.get("MainTex") or tx.get("EmissionMap")
    tex = {k: v for k, v in (("_MainTex", main), ("_BumpMap", tx.get("BumpMap")), ("_SmoothnessMap", tx.get("SmoothnessMap")),
                             ("_TransparencyMap", tx.get("TransparencyMap")), ("_SpecGlossMap", spec_gloss)) if v}
    f = {"_IsWet": 1.0, "_IsColored": 0.0, "_Cutoff": 0.5, "_Albedo_Contrast": 1.0, "_Normals_Scale": float(CFG.get("normals_scale", 1.0)),
         "_SmoothnessBoost": smoothness_boost, "_SmoothnessContrast": 1.0, "_Specular": specular, "_Cull": 0.0,
         "_SubsurfaceID": 0.0, "_HideVertexAlpha": 1.0}
    if cutoff is not None:                                     # suit_alpha_cut: the dithered cut-out line of an SDF alpha map (Unified discards when alpha < noise x _Cutoff)
        f["_Cutoff"] = float(cutoff)
    kw = ["_ISWET_ON", "_HIDEVERTEXALPHA_ON"] + (["_ALPHATEST_ON"] if "_TransparencyMap" in tex else [])
    return material(mat_name, "Unified", tex, f, {"_Color": (1, 1, 1, 1)}, keywords=kw)


def emissive_triangles(obj_tag, uv0, subs, threshold=24):
    """keep only triangles whose UV centroid is lit in the model's own emission bake (e.g. the glowing irises)"""
    from PIL import Image
    f = os.path.join(CFG["bake_dir"], f"{obj_tag}_emit.1001.png")
    em = np.asarray(Image.open(f).convert("L")).astype(float)
    h, w_ = em.shape
    out = []
    for tri in subs:
        c = uv0[tri].mean(1)
        x = np.clip((c[:, 0] * w_).astype(int), 0, w_ - 1); y = np.clip(((1 - c[:, 1]) * h).astype(int), 0, h - 1)
        out.append(tri[em[y, x] > threshold])
    return out


