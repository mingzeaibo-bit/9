STRIPPED_WET = []


def material(name, shader_name, tex=None, floats=None, colors=None, keywords=(), queue=-1, tags=None):
    if STRIP_WET_RX is not None and STRIP_WET_RX.search(name) and any(k in ("_ISWET_ON", "_ISCOLORED_ON") for k in keywords):
        keywords = tuple(k for k in keywords if k not in ("_ISWET_ON", "_ISCOLORED_ON"))
        STRIPPED_WET.append(name)
    pid = w.reserve("Material")
    t = w.default("Material")
    tex = tex or {}
    # cfg material_valid_keywords (absent = old: every keyword stored invalid): keywords the shipped Unified/StandardAdvanced
    # materials store as VALID (data/corpus_full/materials.json keyword_share_valid_only), the rest (e.g. _HIDEVERTEXALPHA_ON,
    # _LIGHTMAP_UV2_ON, _ALPHATEST_ON) stay invalid like shipped (refs 13 S10 #8)
    _vk = set(CFG.get("material_valid_keywords", []))
    t.update({"m_Name": name, "m_Shader": pptr(SH[shader_name]), "m_ValidKeywords": sorted(k for k in keywords if k in _vk),
              "m_InvalidKeywords": sorted(k for k in keywords if k not in _vk),
              "m_CustomRenderQueue": int(queue), "m_LightmapFlags": 4, "m_EnableInstancingVariants": False, "m_DoubleSidedGI": False})
    if tags:
        t["m_StringTagMap"] = [[k, v] for k, v in tags]
    sp = t["m_SavedProperties"]
    sp["m_TexEnvs"] = [[k, {"m_Texture": pptr(v), "m_Scale": {"x": 1.0, "y": 1.0}, "m_Offset": {"x": 0.0, "y": 0.0}}]
                       for k, v in sorted(tex.items())]
    sp["m_Floats"] = [[k, float(v)] for k, v in sorted((floats or {}).items())]
    sp["m_Colors"] = [[k, {"r": float(c[0]), "g": float(c[1]), "b": float(c[2]), "a": float(c[3])}] for k, c in sorted((colors or {}).items())]
    w.fill(pid, t)
    return pid


