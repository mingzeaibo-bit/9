def _sac_kind(suffix):
    k_ = suffix[1:] if suffix.startswith("_") else suffix
    for kind_ in ("opaque", "translucent"):
        if k_ in (SAC.get(kind_) or {}).get("variants", []):
            return kind_
    return None


def _sac_tex(kind_):
    nm_ = SAC[kind_]["map"]
    t_ = tex_if(nm_)
    if not t_:
        raise SystemExit(f"suit_alpha_cut: texture {nm_} not found in tex_dirs (encode the SDF alpha PNG with scripts/suit_alpha_encode.py)")
    return t_


def suit_v3_mats(main_prefix, suffix="", trans=False, even=False):
    """Unified = metal workflow (_SpecGlossMap.r = metalness): latex = metal 0 -> no _SpecGlossMap, _Specular suit_specular
    (0); trans = screen-door stipple (_TransparencyMap.a + _Cutoff 1, double-sided). Second material = cyborg skin."""
    pre_ = CFG.get("suit_tex_prefix", f"{CFG['display_name']}_Suit")
    tx_ = {"MainTex": tex_if(main_prefix + "_MainTex"), "BumpMap": tex_if(pre_ + "_BumpMap"),
           "SmoothnessMap": tex_if(pre_ + "_SmoothnessMap")}
    kind_ = _sac_kind(suffix) if SAC else None
    if SAC and kind_ is None:
        REPORT.setdefault("warnings", []).append(f"suit_alpha_cut: variant '{suffix}' is in neither list: it keeps the bare region")
    if kind_ == "translucent" and not trans:
        raise SystemExit(f"suit_alpha_cut: variant '{suffix}' is listed as translucent but is built opaque")
    if kind_ == "opaque" and trans:
        raise SystemExit(f"suit_alpha_cut: variant '{suffix}' is listed as opaque but is built translucent")
    if kind_:
        SAC_USED[suffix or "(main)"] = {"kind": kind_, "map": SAC[kind_]["map"], "cutoff": SAC[kind_].get("cutoff"), "skin_cut": SAC.get("skin_cut")}
    if even and not trans:                                          # cfg suit_t_even (clearsuit 2026-10-26, user-approved; absent = old behaviour): the clear looks get ONE
        _ev = CFG.get("suit_t_even") or {}                          # material on both submeshes, constant smoothness (no _SmoothnessMap: Unified smooth = map.r (default black) + boost, refs 27)
        ms = cloth_material(f"{CFG['display_name']}_Bodysuit{suffix}", {k: v for k, v in tx_.items() if k != "SmoothnessMap"}, spec_gloss=None,
                            specular=float(_ev.get("specular", CFG.get("suit_specular", 0.0))), smoothness_boost=float(_ev.get("smoothness", 0.55)))
        REPORT.setdefault("suit_t_even", {})[suffix] = {"smoothness": float(_ev.get("smoothness", 0.55)), "materials": 1}
        return [ms, ms]
    if trans:
        ms = material(f"{CFG['display_name']}_Bodysuit{suffix}", "Unified",
                      {k: v for k, v in (("_MainTex", tx_["MainTex"]), ("_BumpMap", tx_["BumpMap"]),
                                         ("_SmoothnessMap", tx_["SmoothnessMap"]),
                                         ("_TransparencyMap", _sac_tex("translucent") if kind_ == "translucent" else tex_if(pre_ + "T_TransparencyMap"))) if v},
                      {"_IsWet": 1.0, "_IsColored": 0.0, "_Cutoff": float((SAC.get("translucent") or {}).get("cutoff", 1.0)) if kind_ == "translucent" else 1.0, "_Albedo_Contrast": 1.0,
                       "_Normals_Scale": float(CFG.get("normals_scale", 1.0)), "_SmoothnessBoost": 0.0,
                       "_SmoothnessContrast": 1.0, "_Specular": 0.0, "_Cull": 0.0, "_SubsurfaceID": 0.0, "_HideVertexAlpha": 1.0},
                      {"_Color": (1, 1, 1, 1)}, keywords=("_ISWET_ON", "_HIDEVERTEXALPHA_ON", "_ALPHATEST_ON"))
    else:
        if kind_ == "opaque":
            tx_ = dict(tx_, TransparencyMap=_sac_tex("opaque"))
        ms = cloth_material(f"{CFG['display_name']}_Bodysuit{suffix}", tx_, spec_gloss=None,
                            specular=float(CFG.get("suit_specular", 0.0)),
                            smoothness_boost=float(CFG.get("suit_smoothness_boost", 0.0)),
                            cutoff=(SAC["opaque"].get("cutoff") if kind_ == "opaque" else None))
    _skin_tex = {k: v for k, v in (("_MainTex", tx_["MainTex"]), ("_BumpMap", tx_["BumpMap"]), ("_SmoothnessMap", tx_["SmoothnessMap"])) if v}
    _skin_f, _skin_kw = dict(skin_f, _IsColored=0.0), ("_ISWET_ON", "_HIDEVERTEXALPHA_ON")
    if kind_ and SAC.get("skin_cut"):                                 # the skin submesh has triangles inside the bare region too (676 of 63 k): same map, same cutoff
        _sk_kind = SAC["skin_cut"]
