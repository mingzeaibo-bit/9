            ns = (_EXT >= 0) & _PAROK
            eh = np.where(ns & hid[_PAR].all(1))[0]; ep = np.where(ns & ~hid[_PAR].all(1) & (hid | pus)[_PAR].all(1))[0]
            pr = np.maximum(rat[_PAR[ep]].max(1), 0.5) if len(ep) else []
            add = [{"vertId": int(_EXT[v_]), "minHitRatio": 0.999, "visibility": 0.0} for v_ in eh if int(_EXT[v_]) not in ent]
            nh = len(add)
            add += [{"vertId": int(_EXT[v_]), "minHitRatio": float(r_), "visibility": 1.0} for v_, r_ in zip(ep, pr) if int(_EXT[v_]) not in ent]
            HIDEFIX["lists"] += 1; HIDEFIX["added_hidden"] += nh; HIDEFIX["added_pushed"] += len(add) - nh
            return list(lst) + add
        _fill0 = w.fill

