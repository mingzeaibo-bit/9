        from scipy.spatial import cKDTree as _KD
        _hf = CFG["hidefix"] if isinstance(CFG["hidefix"], dict) else {}
        _hit = np.asarray(XW["_hit"], np.int64)
        _dk, _jk = _KD(XW["_own_V"][_hit]).query(XW["_own_V"], k=int(_hf.get("k", 3)))
        _PAR = _hit[_jk]; _PAROK = (_dk <= float(_hf.get("mm", 6.0)) / 1000.0).all(1)
        _EXT = np.asarray(XW["_ext_of"], np.int64); _MAP = np.asarray(XW["map"], np.int64)
        HIDEFIX = {"lists": 0, "added_hidden": 0, "added_pushed": 0, "map_length": int(len(_MAP)), "k": int(_hf.get("k", 3)), "mm": float(_hf.get("mm", 6.0))}
        REPORT["hidefix"] = HIDEFIX

        def hide_inherit(lst):
            ent = {int(e["vertId"]) for e in lst}
            n_ = len(XW["_own_V"]); hid = np.zeros(n_, bool); pus = np.zeros(n_, bool); rat = np.zeros(n_)
            for e in lst:
                s_ = int(e["vertId"])
                if 0 <= s_ < len(_MAP):
                    if float(e.get("visibility", 0.0)) > 0:
                        pus[_MAP[s_]] = True; rat[_MAP[s_]] = max(rat[_MAP[s_]], float(e.get("minHitRatio", 0.999)))
                    else:
