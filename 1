def extend(line, inward, depth_total, n=5):
    line = [np.array(p) for p in line]
    while len(line) < 2:
        line.append(line[-1] + np.array(inward) * 0.01)
    out = [line[0]]
    for t in np.linspace(0, 1, 3)[1:]:
        out.append(line[int(round(t * (len(line) - 1)))])
    end = out[-1]
    out.append(end + np.array(inward) * depth_total * 0.35)
    out.append(end + np.array(inward) * depth_total * 0.7)
    return out[:5]


