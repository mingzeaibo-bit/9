def tex_tags(obj_tag, nsub):
    """texture prefix per submesh: the item's own tag, or its shared set (cfg shared_tex_sets)."""
    pre = SHARED["items"].get(obj_tag)
    if not pre:
        return [obj_tag] * nsub
    out = [pre] * nsub
    over = dict(SHARED.get("submesh_overrides", {}).get(obj_tag, {}))
    if not over and SHARED.get("weapon_decal_prefix") and "Weapon" in obj_tag and nsub > 1:
        over = {"1": SHARED["weapon_decal_prefix"]}                # texture baker: weapon submesh 1 = the decal
    for k, v in over.items():
        if int(k) < nsub:
            out[int(k)] = v
    return out


def tex_file(name, ext):
    for d_ in TEX_DIRS:
        f_ = os.path.join(d_, name + ext)
        if os.path.isfile(f_):
            return f_
    return os.path.join(TEX_DIRS[-1], name + ext)


def texture(name):
    meta = json.load(open(tex_file(name, ".json")))
    data = open(tex_file(name, ".bin"), "rb").read()
    pid = w.reserve("Texture2D")
    t = w.default("Texture2D")
    t.update({"m_Name": name, "m_Width": meta["width"], "m_Height": meta["height"], "m_CompleteImageSize": len(data),
              "m_TextureFormat": meta["format"], "m_MipCount": meta["mips"], "m_IsReadable": False, "m_ImageCount": 1,
              "m_TextureDimension": 2, "m_ColorSpace": 1 if meta["srgb"] else 0,
              "m_LightmapFormat": 3 if name.endswith("_BumpMap") else 0,
              "m_TextureSettings": {"m_FilterMode": 2, "m_Aniso": 8, "m_MipBias": 0.0,
                                    **({"m_WrapU": 0, "m_WrapV": 0, "m_WrapW": 0} if any(name.startswith(p_ + "_") for p_ in SHARED_PREFIXES)
                                       else {"m_WrapU": 1, "m_WrapV": 1, "m_WrapW": 1})},
              "image data": data, "m_StreamData": {"offset": 0, "size": 0, "path": ""}})
    w.fill(pid, t)
    REPORT["objects"][name] = {"format": meta["format"], "size": meta["width"], "MB": round(len(data) / 2 ** 20, 1)}
    REPORT.setdefault("tex_sources", {})[name] = os.path.dirname(tex_file(name, ".bin")).replace("\\", "/")      # which tex_dirs entry served it (first match): the queue's post-build check compares it with the dirs it chose
    return pid


