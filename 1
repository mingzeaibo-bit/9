def smr(path, mesh_pid, mats, V, root="DEF-Hips", bones_tr=None, enabled=None, offscreen=None, weights=None):
    # shipped contract (prefab_fulldiff): collision SMRs under Colliders/ and the Body_ patches are DISABLED; only
    # display meshes render. m_UpdateWhenOffscreen False everywhere (Girl.InitMergedBody sets it at runtime).
    if enabled is None:
        enabled = "/Colliders/" not in path
    if mesh_pid in MESH_KEEP:                                      # bone_trim: m_Bones = the kept entries of the list the mesh was built for
        _kp, _nb = MESH_KEEP[mesh_pid]
        _full = list(bones_tr or BONE_TR)
        if len(_full) != _nb:
            raise SystemExit(f"bone_trim: SMR {path} lists {len(_full)} bones but its mesh was built for {_nb} bind poses")
        bones_tr = [_full[i_] for i_ in _kp]
    pid = P.component(path, "SkinnedMeshRenderer")
    t = w.default("SkinnedMeshRenderer")
    rootW = W_rest[root]
    Pl = (np.linalg.inv(rootW) @ np.c_[V, np.ones(len(V))].T).T[:, :3]
    lo, hi = Pl.min(0), Pl.max(0)
    t.update({"m_Enabled": bool(enabled), "m_CastShadows": 1, "m_ReceiveShadows": 1, "m_DynamicOccludee": 1, "m_MotionVectors": 1,
              "m_LightProbeUsage": 1, "m_ReflectionProbeUsage": 1, "m_RayTracingMode": 3, "m_RenderingLayerMask": 1,
              "m_LightmapIndex": 65535, "m_LightmapIndexDynamic": 65535,
              "m_LightmapTilingOffset": {"x": 1.0, "y": 1.0, "z": 0.0, "w": 0.0},
              "m_LightmapTilingOffsetDynamic": {"x": 1.0, "y": 1.0, "z": 0.0, "w": 0.0},
              "m_Materials": [pptr(m) for m in mats], "m_Quality": 0, "m_UpdateWhenOffscreen": bool(offscreen) if offscreen is not None else False,
              "m_SkinnedMotionVectors": True, "m_Mesh": pptr(mesh_pid), "m_Bones": [pptr(b) for b in (bones_tr or BONE_TR)],
              "m_BlendShapeWeights": [float(x) for x in (weights or [])], "m_RootBone": pptr(bone_tr(root)),
              "m_AABB": {"m_Center": v3((lo + hi) / 2), "m_Extent": v3((hi - lo) / 2)}, "m_DirtyAABB": False})
    P.fill(pid, t)
    return pid


