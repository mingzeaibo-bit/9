    OUTFIT = plan_outfits(CFG["outfit_presets"], os.path.join(OWN, "outfit_switches.json"), CFG.get("extras", []))
    if SS:
        SS.finish_plan(OUTFIT)                                       # key ownership per new slot + m_Enabled AND rules
    CF.apply_plan(OUTFIT)                                            # clip-fix Mask_* weights per option (no-op when off)
    if CFG.get("strip_safe_sliders", True):    # user 2026-10-26: the game's strip-nude = Lua human.CustomizeAll(99) puts EVERY slider on its LAST step (dress = CustomizeAll(0)):
        import copy as _copy                    # last step of every slot = nothing (Outfit: Nude, options in the reference-page order), Hair's last step = full hair
        _OFF = ("Off", "Bare", "Nude", "None")
        for _sl in OUTFIT["slots"]:
            _o = _sl["options"]
            if _sl["slot"] == "Outfit" and CFG.get("outfit_order"):
                _ord = CFG["outfit_order"]
                _o.sort(key=lambda o: _ord.index(o["name"]) if o["name"] in _ord else len(_ord) - 1.5)   # option dicts carry their own data (visible, body_keys)
            _last = CFG.get("slot_last", {}).get(_sl["slot"])
            if _last is None and _o[-1]["name"] not in _OFF:
                _last = next((o["name"] for o in _o if o["name"] in _OFF), None)
            if _last and _o[-1]["name"] != _last:
                _src = next((o for o in _o if o["name"] == _last), None)
                if _src is not None:
                    _o.append(_copy.deepcopy(_src))
        REPORT["strip_safe_sliders"] = {s_["slot"]: [o["name"] for o in s_["options"]] for s_ in OUTFIT["slots"]}
    OUT_ITEMS = {}                                                   # model object -> {item, smr, mesh, mats, V, N, bones, hide}
