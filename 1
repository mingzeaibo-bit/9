def suit_v3_collider(name, smr_pid, mesh_pid, mats, Vv, bones, hide, push, cs=None, proxy=None):
    P.node(f"{R}/Colliders/{name}")
    ac = reserve_script(f"{R}/Colliders/{name}", "AdvancedCollider")
    P.node(f"{R}/Colliders/{name}/{name}")
    if proxy:                                                       # budgeted proxy (shared by the colour variants of one geometry)
        col = smr(f"{R}/Colliders/{name}/{name}", proxy["mesh"], mats[:proxy.get("nsub", 1)], proxy["V"], bones_tr=bones)
        PB_SLOTS[name] = {k_: proxy[k_] for k_ in ("tris", "verts", "display_verts")}
    else:
        col = smr(f"{R}/Colliders/{name}/{name}", mesh_pid, mats, Vv, bones_tr=bones)
    dob = w.reserve("AdvancedCollider_DataObject")
    dd = w.default("AdvancedCollider_DataObject")
    if cs:
        lst = cs["m_bodyVertPushList"]
    else:
        lst = xw_push(hide)                                         # own ids -> standard ids when the contract is on
        for v_, r_ in push:
            lst = lst + xw_push([v_], min_hit=float(r_), visibility=1.0)
    dd.update({"m_Name": f"Collider_Data_{name}", "m_reducedToFullIds": [], "m_bodyVertPushList": lst})
    w.fill(dob, dd)
    acs_ = {"m_skinRD": pptr(smr_pid), "m_skinColRD": pptr(col), "m_data": pptr(dob), "m_pushBody": 1, "m_wrapToBody": 1}
    if cs:
        acs_.update({"m_pushDistance": cs["m_pushDistance"], "m_forceHideList": cs["m_forceHideList"]})
    fill_script(ac, "AdvancedCollider", acs_)
    return ac


