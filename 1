def mesh_object(name, V, N, TAN, COL, uvs, subs, BI, BW, shapes, bind=None):
    if CFG.get("sort_bone_weights") and BI is not None and BW is not None and np.ndim(BW) == 2 and BW.shape[1] > 1:
        # Unity expects each vertex's influences sorted by weight, largest first (geom gate G08; m21a: 13 unsorted rows from
        # the clip-fix garment weights). Stable sort keeps the order of equal weights.
        _o = np.argsort(-np.asarray(BW, np.int64), axis=1, kind="stable")
        BI = np.take_along_axis(np.asarray(BI), _o, axis=1); BW = np.take_along_axis(np.asarray(BW), _o, axis=1)
    _keep = None
    if BONE_TRIM and BI is not None and BW is not None:
        if any(s_ in name for s_ in BONE_TRIM_SKIP):
            TRIM_STATS["skipped"].append(name)
        else:
            _full = np.asarray(BIND if bind is None else bind)
            _bi, _bw = np.asarray(BI), np.asarray(BW)
            if _bi.size and int(_bi.max()) >= len(_full):
                raise SystemExit(f"bone_trim: mesh {name} has a bone index {int(_bi.max())} >= its {len(_full)} bind poses")
            _on = _bw > 0
            _used = np.unique(_bi[_on]) if _on.any() else np.zeros(0, np.int64)
            if not len(_used):
                _used = np.zeros(1, np.int64)
            TRIM_STATS["meshes"] += 1; TRIM_STATS["bones_before"] += int(len(_full)); TRIM_STATS["bones_after"] += int(len(_used))
            if len(_used) < len(_full):
                _remap = np.zeros(len(_full), np.int64); _remap[_used] = np.arange(len(_used))
                _bi2 = np.where(_on, _remap[_bi], 0).astype(_bi.dtype)             # weight-0 slots point at bone 0 (always a valid index)
                assert (_used[_bi2[_on]] == _bi[_on]).all() and np.array_equal(_full[_used][_bi2[_on]], _full[_bi[_on]]), name      # same bone AND same bind pose for every weighted influence
                BI, bind, _keep = _bi2, _full[_used], (_used, int(len(_full)))
            else:
                TRIM_STATS["kept_full"].append(name)
    pid = w.reserve("Mesh")
    if _keep is not None:
        MESH_KEEP[pid] = _keep
    t = build_mesh(w.default("Mesh"), name, V, N, TAN, COL, uvs, subs, BI, BW, BIND if bind is None else bind, shapes)
    w.fill(pid, t)
    REPORT["objects"][name] = {"vertices": int(len(V)), "triangles": int(sum(len(s) for s in subs)),
                               "shapes": [s for s, _ in shapes]}
    if _keep is not None:
        REPORT["objects"][name]["bones"] = [_keep[1], int(len(_keep[0]))]
    return pid


