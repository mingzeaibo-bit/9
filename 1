    if PROBE_STUB:                                                   # objects of a slot that are not visible in the slot's first (default) option
        _vis0, _allo = set(), set()
        for _sl in OUTFIT["slots"]:
            _allo |= set(_sl["objects"]); _vis0 |= set(_sl["options"][0]["visible"])
        HIDDEN0 = _allo - _vis0
    for obj, info in OUTFIT["objects"].items():
        if info["extra"]:                                            # already built as an extra (hair strands, horns, nails …)
            OUT_ITEMS[obj] = {"item": info["extra"], "extra": True}
            continue
        bobj = "BAKED_" + obj
        if bobj not in MB.man["objects"]:
            REPORT.setdefault("outfit_missing", []).append(obj); continue
        m = MB.build(bobj, key_names=CF.item_keys(obj, info["keys"], OUTFIT) if CF.on else (info["keys"] or None),   # + D13 cross-slot keys
                     **({"raw_uv": True} if obj in SHARED["items"] else {}))   # shared texture set: raw UVMap
        if CF.on:
            CF.reweight(obj, m)                                      # clip-fix garment weights (rigidify below still wins)
        if obj in CFG.get("rigid_items", {}):                        # e.g. {"Shion_Robotic_Head": "head_base"}
            rigidify(m, CFG["rigid_items"][obj])
        SR.mesh(info["item"], m)                                    # skin repair: garment weights from the repaired body
        if XW_STD is not None:                                      # no "Bone not found" on transfer
            REPORT.setdefault("crosswear_bones", {})[info["item"]] = crosswear_bones.to_standard(m, XW_T, XW_STD, XW_KEEP)
        bnames = m["BONES"]
        bind_o = np.stack([np.linalg.inv(W_rest[b]) for b in bnames])
        shapes_o = [(k[7:], m[k]) for k in m if k.startswith("SHAPE__")]
