    bl = list(body["BONES"])
    for b in fz["BONES"]:                                       # piece bones the female body never uses (e.g. shaftRoot_base)
        if b not in bl:
            bl.append(b)
    body["BONES"] = np.array(bl)
    remapb = np.array([bl.index(b) for b in fz["BONES"]], np.int64)
    for k in ("V", "N", "TAN", "COL", "UV0", "UV1", "UV2"):
        body[k] = np.concatenate([body[k], fz[k].astype(body[k].dtype)])
    body["BI"] = np.concatenate([body["BI"], remapb[fz["BI"].astype(np.int64)].astype(body["BI"].dtype)])
    body["BW"] = np.concatenate([body["BW"], fz["BW"].astype(body["BW"].dtype)])
    body["TRI0"] = np.concatenate([body["TRI0"], fz["TRI"].astype(body["TRI0"].dtype) + n0])
